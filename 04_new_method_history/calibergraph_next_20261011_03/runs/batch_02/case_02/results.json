      "pair": [
        "SELECT DATE_ID, MAKE_NAME, COUNT(DISTINCT LEAD_ID) AS UNIQUE_LEADS, COUNT(DISTINCT PARTNER_ID) AS UNIQUE_PARTNERS FROM DAILYSALES GROUP BY DATE_ID, MAKE_NAME",
        "SELECT DATE_ID, MAKE_NAME, SUM(CASE WHEN LEAD_ID NOT IN (0) THEN 1 END) UNIQUE_LEADS, SUM(CASE WHEN PARTNER_ID NOT IN (0) THEN 1 END) UNIQUE_PARTNERS FROM ( (SELECT DATE_ID,MAKE_NAME, LEAD_ID+1 AS LEAD_ID, 0 AS PARTNER_ID FROM DAILYSALES GROUP BY 1,2,3 ) UNION ALL (SELECT DATE_ID,MAKE_NAME, 0 AS LEAD_ID, PARTNER_ID+1 AS PARTNER_ID FROM DAILYSALES GROUP BY 1,2,4 )) AS A GROUP BY 1,2"
      ],
